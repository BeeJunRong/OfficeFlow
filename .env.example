# OfficeFlow 环境配置示例
# 用法：Copy-Item .env.example .env  然后填入真实值
# 说明：已存在的进程环境变量优先于本文件（可用 $env: 临时覆盖）
#      不填 OFFICEFLOW_MODEL_API_KEY 也能跑：自动降级为内置规则引擎（离线可用）

# ---------- 模型服务（OpenAI 兼容协议）----------
# DeepSeek / Qwen / 本地 Ollama 均可
OFFICEFLOW_MODEL_API_KEY=
OFFICEFLOW_MODEL_BASE_URL=https://api.deepseek.com/v1
OFFICEFLOW_MODEL_NAME=deepseek-chat
OFFICEFLOW_MODEL_TIMEOUT=60

# 本地 Ollama 零成本方案（取消注释并把上面的 API_KEY 设为占位值）：
# OFFICEFLOW_MODEL_BASE_URL=http://localhost:11434/v1
# OFFICEFLOW_MODEL_NAME=qwen2.5:7b
# OFFICEFLOW_MODEL_API_KEY=ollama

# ---------- LangExtract 抽取路径（docs/开源选型.md 方案 A）----------
# 默认关闭；开启前请先跑 scripts/check_langextract.py 自检
OFFICEFLOW_LANGEXTRACT_ENABLE=0
OFFICEFLOW_LANGEXTRACT_MAX_CHAR_BUFFER=1000
OFFICEFLOW_LANGEXTRACT_MAX_WORKERS=4
# >1 可提升召回，但 token 消耗成倍增长
OFFICEFLOW_LANGEXTRACT_PASSES=1
# DeepSeek 兼容端点对 response_format=json_schema 支持不一，故默认关闭
OFFICEFLOW_LANGEXTRACT_SCHEMA_CONSTRAINTS=0

# ---------- 邮件发送（FR-03"协议"；默认关闭，Q-02 合规）----------
# 默认协议 draft_only：只生成草稿，绝不发送。
# 仅当需要"服务端 SMTP 直发"时才填下面几项——且必须同时把
# OFFICEFLOW_EMAIL_ENABLE_SEND 设为 1，并在界面逐封显式确认。
# 不配置时 smtp 协议不可用，界面会明确提示，不会谎报发送成功。
OFFICEFLOW_EMAIL_ENABLE_SEND=0
# OFFICEFLOW_SMTP_HOST=smtp.example.com
# OFFICEFLOW_SMTP_PORT=587
# OFFICEFLOW_SMTP_USER=you@example.com
# OFFICEFLOW_SMTP_PASSWORD=
# OFFICEFLOW_SMTP_FROM=you@example.com
# OFFICEFLOW_SMTP_TLS=1

# ---------- 应用配置 ----------
OFFICEFLOW_BACKEND=http://localhost:8888
OFFICEFLOW_EXPORT_DIR=exports
OFFICEFLOW_DB_PATH=officeflow_logs.db
OFFICEFLOW_ENABLE_DB=1
